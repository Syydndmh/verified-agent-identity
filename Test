name: Verify Human Identity

on:
  workflow_dispatch:
    inputs:
      agent_name:
        description: 'Nama agent kamu'
        required: true
        default: 'xavien'
      agent_description:
        description: 'Deskripsi agent'
        required: true
        default: 'xavien AI Agent'

jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4   # upgrade ke v4 biar lebih fresh

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: Install ClawHub CLI globally
        run: npm install -g clawhub@latest

      - name: Verify ClawHub installed
        run: clawhub --version || echo "ClawHub gagal install, cek log"

      - name: Step 1 - Install verified-agent-identity skill
        run: clawhub install verified-agent-identity --force   # --force biar overwrite kalau sudah ada

      - name: Install script dependencies (jika ada package.json di skill)
        run: |
          if [ -d "skills/verified-agent-identity" ]; then
            cd skills/verified-agent-identity
            if [ -f "package.json" ]; then
              npm install
            fi
            cd ../..
          else
            echo "Folder skill tidak ditemukan!"
            exit 1
          fi

      - name: Step 2 - Create new Ethereum Identity
        run: node skills/verified-agent-identity/scripts/createNewEthereumIdentity.js

      - name: Step 3 - Link Human to Agent
        run: |
          node skills/verified-agent-identity/scripts/manualLinkHumanToAgent.js \
            --challenge '{"name": "${{ inputs.agent_name }}", "description": "${{ inputs.agent_description }}"}'

      - name: Debug - Show directory structure (kalau error)
        if: always()
        run: ls -la skills/verified-agent-identity || echo "Skill folder tidak ada"
